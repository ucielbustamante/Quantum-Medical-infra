{
  "openapi": "3.0.0",
  "info": {
    "title": "Quantum Medical API",
    "version": "1.0.0",
    "description": "API para el sistema de gestión médica Quantum Medical"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Servidor de desarrollo"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["Patient", "Doctor", "Admin"]
          },
          "dni": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "Doctor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "license_number": {
            "type": "string"
          },
          "User": {
            "$ref": "#/components/schemas/User"
          },
          "Specialties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Specialty"
            }
          }
        }
      },
      "Patient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "health_insurance": {
            "type": "string"
          },
          "health_insurance_number": {
            "type": "string"
          },
          "birthday": {
            "type": "string",
            "format": "date"
          },
          "User": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Specialty": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "DoctorSpecialty": {
        "type": "object",
        "properties": {
          "doctor_id": {
            "type": "string",
            "format": "uuid"
          },
          "specialty_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Registrar nuevo usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name", "lastname", "role", "dni"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "lastname": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["Patient", "Doctor", "Admin"]
                  },
                  "dni": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado exitosamente"
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Solicitar reset de contraseña",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email de reset enviado"
          },
          "404": {
            "description": "Usuario no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password/confirm": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Confirmar reset de contraseña",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "newPassword"],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Token de recuperación recibido por email"
                  },
                  "newPassword": {
                    "type": "string",
                    "description": "Nueva contraseña"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña actualizada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Token inválido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "tags": ["Autenticación"],
        "summary": "Iniciar autenticación con Google",
        "responses": {
          "302": {
            "description": "Redirección a Google OAuth"
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": ["Autenticación"],
        "summary": "Callback de autenticación Google",
        "responses": {
          "302": {
            "description": "Redirección con token JWT"
          }
        }
      }
    },
    "/rbac/doctor/dashboard": {
      "get": {
        "tags": ["RBAC"],
        "summary": "Obtener dashboard del doctor",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Dashboard del doctor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "doctor": {
                          "$ref": "#/components/schemas/Doctor"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/rbac/admin/users": {
      "get": {
        "tags": ["RBAC"],
        "summary": "Listar todos los usuarios (Admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de usuarios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "users": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/User"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rbac/patient/profile": {
      "get": {
        "tags": ["RBAC"],
        "summary": "Obtener perfil del paciente",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Perfil del paciente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "allOf": [
                            { "$ref": "#/components/schemas/User" },
                            {
                              "type": "object",
                              "properties": {
                                "patient": {
                                  "$ref": "#/components/schemas/Patient"
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/doctors/search": {
      "post": {
        "tags": ["Doctores"],
        "summary": "Buscar doctores",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lista de doctores encontrados"
          }
        }
      }
    },
    "/doctors/{id}": {
      "put": {
        "tags": ["Doctores"],
        "summary": "Actualizar doctor",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "license_number": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Doctor actualizado"
          }
        }
      },
      "delete": {
        "tags": ["Doctores"],
        "summary": "Eliminar doctor",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Doctor eliminado"
          }
        }
      }
    },
    "/patients/search": {
      "post": {
        "tags": ["Pacientes"],
        "summary": "Buscar pacientes",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lista de pacientes encontrados"
          }
        }
      }
    },
    "/patients/{id}": {
      "put": {
        "tags": ["Pacientes"],
        "summary": "Actualizar paciente",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "health_insurance": {
                    "type": "string"
                  },
                  "health_insurance_number": {
                    "type": "string"
                  },
                  "birthday": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paciente actualizado"
          }
        }
      },
      "delete": {
        "tags": ["Pacientes"],
        "summary": "Eliminar paciente",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paciente eliminado"
          }
        }
      }
    },
    "/specialties": {
      "get": {
        "tags": ["Especialidades"],
        "summary": "Listar todas las especialidades",
        "responses": {
          "200": {
            "description": "Lista de especialidades",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Specialty"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Especialidades"],
        "summary": "Crear nueva especialidad",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Especialidad creada"
          }
        }
      }
    },
    "/specialties/{id}": {
      "put": {
        "tags": ["Especialidades"],
        "summary": "Actualizar especialidad",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "is_active": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Especialidad actualizada"
          }
        }
      },
      "delete": {
        "tags": ["Especialidades"],
        "summary": "Eliminar especialidad",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Especialidad eliminada"
          }
        }
      }
    },
    "/doctor-specialties": {
      "get": {
        "tags": ["Doctor-Especialidades"],
        "summary": "Listar todas las asociaciones doctor-especialidad",
        "responses": {
          "200": {
            "description": "Lista de asociaciones",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DoctorSpecialty"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Doctor-Especialidades"],
        "summary": "Crear nueva asociación doctor-especialidad",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["doctor_id", "specialty_id"],
                "properties": {
                  "doctor_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "specialty_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Asociación creada"
          }
        }
      }
    },
    "/doctor-specialties/{doctor_id}/{specialty_id}": {
      "delete": {
        "tags": ["Doctor-Especialidades"],
        "summary": "Eliminar asociación doctor-especialidad",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "doctor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "specialty_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Asociación eliminada"
          }
        }
      }
    }
  }
}
